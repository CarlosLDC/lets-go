{
  "expo": {
    "name": "LetsGo",
    "slug": "lets-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "letsgo",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F5F7FA",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ve.letsgo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LetsGo necesita tu ubicación para mostrarte estacionamientos cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2E4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ve.letsgo.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que LetsGo acceda a tu ubicación para mostrarte estacionamientos cercanos."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#1A2E4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
